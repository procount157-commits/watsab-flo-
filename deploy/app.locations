client_max_body_size 80m;

location /api/ {
    proxy_pass http://wam_api;
    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # Campaigns and the QR poll are long-lived; the default 60s cuts them off.
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
}

# Tracking redirects are served by the API too.
location /t/ { proxy_pass http://wam_api; proxy_set_header Host $host; }

# The home page: generated HTML for anyone without a session cookie (a
# crawler, a visitor), the app shell for someone signed in. The map is in
# nginx.conf because a map must sit at http level.
location = / {
    root /usr/share/nginx/html;
    if ($wam_crawler = 1) { rewrite ^ /home/index.html last; }
    try_files /index.html =404;
}

location / {
    root /usr/share/nginx/html;
    # A folder is served by its own index.html, never listed: /features/ has
    # only sub-pages, and "$uri/" alone answered it with 403 Forbidden.
    try_files $uri $uri/index.html /index.html;   # SPA
}

location ~* \.(js|css|png|jpg|jpeg|gif|svg|webp|woff2?)$ {
    root /usr/share/nginx/html;
    expires 1y;
    add_header Cache-Control "public, immutable";
}
